{
  "main function": { "prefix": "main", "body": ["#include <iostream>", "", "int main() {", "    $0", "    return 0;", "}"], "description": "Program with main()" },
  "for loop": { "prefix": "for", "body": ["for (int ${1:i} = 0; $1 < ${2:n}; ++$1) {", "    $0", "}"], "description": "Counting for loop" },
  "range for": { "prefix": "foreach", "body": ["for (const auto& ${1:item} : ${2:items}) {", "    $0", "}"], "description": "Range-based for loop" },
  "while loop": { "prefix": "while", "body": ["while (${1:condition}) {", "    $0", "}"], "description": "while loop" },
  "if": { "prefix": "if", "body": ["if (${1:condition}) {", "    $0", "}"], "description": "if statement" },
  "if else": { "prefix": "ifelse", "body": ["if (${1:condition}) {", "    $2", "} else {", "    $0", "}"], "description": "if ... else" },
  "switch": { "prefix": "switch", "body": ["switch (${1:value}) {", "    case ${2:0}:", "        $0", "        break;", "    default:", "        break;", "}"], "description": "switch statement" },
  "function": { "prefix": "func", "body": ["${1:int} ${2:name}(${3}) {", "    $0", "}"], "description": "Function definition" },
  "class": { "prefix": "class", "body": ["class ${1:Name} {", "public:", "    $1() = default;", "    $0", "", "private:", "};"], "description": "Class definition" },
  "struct": { "prefix": "struct", "body": ["struct ${1:Name} {", "    $0", "};"], "description": "struct definition" },
  "cout": { "prefix": "cout", "body": "std::cout << ${1:value} << '\\n';", "description": "Print a value" },
  "cin": { "prefix": "cin", "body": "std::cin >> ${1:value};", "description": "Read a value" },
  "include": { "prefix": "inc", "body": "#include <${1:iostream}>", "description": "#include a system header" },
  "vector": { "prefix": "vector", "body": "std::vector<${1:int}> ${2:values};", "description": "std::vector" },
  "try catch": { "prefix": "try", "body": ["try {", "    $0", "} catch (const std::exception& ${1:e}) {", "    std::cerr << $1.what() << '\\n';", "}"], "description": "try ... catch" },
  "namespace": { "prefix": "namespace", "body": ["namespace ${1:name} {", "", "$0", "", "} // namespace $1"], "description": "namespace" }
}
