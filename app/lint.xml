<?xml version="1.0" encoding="utf-8"?>
<lint>
    <!-- AAPT2 does not resolve <adaptive-icon> from an unqualified mipmap-anydpi folder; keep -v26. -->
    <issue id="ObsoleteSdkInt">
        <ignore path="src/main/res/mipmap-anydpi-v26" />
    </issue>
    <!-- JGit ships a trust-all TrustManager that it uses only when a repository sets
         http.sslVerify=false. GitService refuses such repositories (requireTlsVerification,
         tested in GitServiceTest), so that code is never reached. -->
    <issue id="TrustAllX509TrustManager">
        <ignore regexp="org\.eclipse\.jgit" />
    </issue>
</lint>
